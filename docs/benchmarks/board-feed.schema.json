{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Benchmark board immutable feed v1",
  "type": "object",
  "required": [
    "schema_version",
    "records"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "records": {
      "type": "array",
      "maxItems": 5000,
      "items": {
        "type": "object",
        "required": [
          "attempt_id",
          "revision",
          "run_id",
          "algorithm_id",
          "algorithm_name",
          "solver_commit",
          "problem",
          "case_id",
          "cores",
          "status",
          "metrics",
          "evaluator",
          "identity",
          "artifacts"
        ],
        "properties": {
          "attempt_id": {
            "type": "string"
          },
          "run_id": {
            "type": "string"
          },
          "algorithm_id": {
            "type": "string"
          },
          "algorithm_name": {
            "type": "string"
          },
          "variant": {
            "type": "string"
          },
          "runtime_id": {
            "type": "string"
          },
          "revision": {
            "type": "integer",
            "minimum": 1
          },
          "solver_commit": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "problem": {
            "enum": [
              "P1",
              "P2",
              "P3"
            ]
          },
          "case_id": {
            "type": "string",
            "pattern": "^(00[1-9]|0[1-9][0-9]|100)$"
          },
          "cores": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          },
          "status": {
            "enum": [
              "ok",
              "failed",
              "timeout",
              "running",
              "not_run",
              "unsupported",
              "withdrawn"
            ]
          },
          "parameters": {
            "type": "object"
          },
          "metrics": {
            "type": "object",
            "description": "makespan_cycles positive numeric preserving int/float type; times in seconds; null for missing. Ratios recomputed, not trusted."
          },
          "evaluator": {
            "type": "object",
            "required": [
              "route",
              "commit",
              "entrypoint"
            ],
            "properties": {
              "route": {
                "enum": [
                  "E0",
                  "E1",
                  "E2"
                ]
              },
              "commit": {
                "type": "string",
                "pattern": "^[0-9a-f]{40}$"
              },
              "entrypoint": {
                "type": "string"
              },
              "calibration_id": {
                "type": "string"
              }
            }
          },
          "identity": {
            "type": "object",
            "properties": {
              "graph_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "config_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "official_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "plan_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          },
          "artifacts": {
            "type": "object",
            "properties": {
              "plan": {
                "type": "object",
                "required": [
                  "path",
                  "sha256"
                ],
                "properties": {
                  "path": {
                    "type": "string"
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  }
                }
              },
              "result": {
                "type": "object",
                "required": [
                  "path",
                  "sha256"
                ],
                "properties": {
                  "path": {
                    "type": "string"
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  }
                }
              },
              "run": {
                "type": "object",
                "required": [
                  "path",
                  "sha256"
                ],
                "properties": {
                  "path": {
                    "type": "string"
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  }
                }
              }
            }
          },
          "baseline": {
            "type": [
              "object",
              "null"
            ],
            "description": "E0 official singlecore only. graph/config/official hashes + entrypoint singlecore_evaluate.evaluate_singlecore + result artifact."
          },
          "cache_pair": {
            "type": [
              "object",
              "null"
            ],
            "description": "E0 P2 result with same graph/config/official/plan hashes, same cores; compared to this P3."
          }
        }
      }
    }
  }
}
