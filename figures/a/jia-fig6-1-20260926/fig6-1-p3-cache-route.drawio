<mxfile host="Electron" agent="drawio" version="24.7.5">
  <diagram id="fig6-1" name="fig-6-1">
    <mxGraphModel dx="800" dy="1200" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="728" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="图 6-1｜P3 结构构造与缓存评价路线（结构候选 → 下界剪枝 → 官方评价 → 严格接受 → 同计划无 L2 对照）" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=13;fontStyle=1;fontFamily=Microsoft YaHei;" vertex="1" parent="1"><mxGeometry x="20" y="4" width="688" height="20" as="geometry" /></mxCell>
        <mxCell id="mainLane" value="" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 4;fillColor=#F4F9FD;strokeColor=#2E86AB;strokeWidth=1.5;fontSize=12;fontFamily=Microsoft YaHei;" vertex="1" parent="1"><mxGeometry x="16" y="28" width="508" height="712" as="geometry" /></mxCell>
        <mxCell id="mainLaneTitle" value="主线｜结构构造与官方评价（forest_solve；311322b）" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;fontStyle=1;fontColor=#1F5FA8;fontFamily=Microsoft YaHei;" vertex="1" parent="1"><mxGeometry x="28" y="32" width="484" height="18" as="geometry" /></mxCell>
        <mxCell id="in" value="输入：原始图 G · 核数 K · 固定配置 θ（P3 共享只读 Cache 场景）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF3FB;strokeColor=#2E86AB;fontSize=11;fontFamily=Microsoft YaHei;" vertex="1" parent="1"><mxGeometry x="96" y="56" width="348" height="34" as="geometry" /></mxCell>
        <mxCell id="idx" value="结构索引（construct）：计算依赖 · 张量生产者/消费者 · 流水线类型 · 计算时长与字节" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5DA7CC;fontSize=10.5;fontFamily=Microsoft YaHei;" vertex="1" parent="1"><mxGeometry x="56" y="102" width="408" height="42" as="geometry" /></mxCell>
        <mxCell id="route" value="结构识别与基准方案（witness_solve.evaluate_candidates；路由表 6.3.1）&#10;① 基础结构路由：窄条件阶段迁移 → 一般阶段 → 注意力/前馈 → 一般 DAG/通用&#10;② 注意力空隙放置　③ 共享输入连续流水（pipeline_solve / calendar_solve）&#10;④ 注意力放置次序保留　⑤ 森林内部峰值排序（forest_memory_order）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5DA7CC;fontSize=10;fontFamily=Microsoft YaHei;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="56" y="156" width="408" height="98" as="geometry" /></mxCell>
        <mxCell id="cand" value="结构候选生成（各路线共享同一 E0 总预算）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5DA7CC;fontSize=10.5;fontFamily=Microsoft YaHei;" vertex="1" parent="1"><mxGeometry x="56" y="266" width="408" height="32" as="geometry" /></mxCell>
        <mxCell id="dedup" value="规范化提交字节去重：重复方案不再评价" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5DA7CC;fontSize=10.5;fontFamily=Microsoft YaHei;" vertex="1" parent="1"><mxGeometry x="56" y="310" width="408" height="32" as="geometry" /></mxCell>
        <mxCell id="prune" value="条件下界剪枝（pipe_bound.analyze）：必需依赖 + 同核 FIFO + 跨核固定等待 → L(P)（式 6-10）&#10;L(P) ≥ 当前合法方案 Makespan → bound_pruned，无需 E0；界不支持则记录后照常评价" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5DA7CC;fontSize=10;fontFamily=Microsoft YaHei;" vertex="1" parent="1"><mxGeometry x="56" y="354" width="408" height="60" as="geometry" /></mxCell>
        <mxCell id="e0" value="官方 P3 评价（未修改 E0；总上限 3 次在线，含基准）&#10;求解器不可修改官方 Cache 替换规则、容量与带宽" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDF8F2;strokeColor=#D35400;fontSize=10.5;fontFamily=Microsoft YaHei;" vertex="1" parent="1"><mxGeometry x="56" y="426" width="408" height="48" as="geometry" /></mxCell>
        <mxCell id="acc" value="严格改进接受：执行合法且 M₃ 严格更小 → 更新当前方案；&#10;合法性拒绝或相同成绩 → 保留已有合法方案（评价异常向外报告，不静默吞掉）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5DA7CC;fontSize=10;fontFamily=Microsoft YaHei;" vertex="1" parent="1"><mxGeometry x="56" y="486" width="408" height="48" as="geometry" /></mxCell>
        <mxCell id="plan" value="最终合法方案及指标（两字段方案 node_to_subgraph ｜ core_schedules；评价账本/选择原因/墙钟）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#B7791F;fontSize=10.5;fontStyle=1;fontFamily=Microsoft YaHei;" vertex="1" parent="1"><mxGeometry x="56" y="546" width="408" height="42" as="geometry" /></mxCell>
        <mxCell id="notebudget" value="E0 预算为每图/核数 3 次在线调用（含基准评价）；候选较少不等于总墙钟等于某内部动态规划时长" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBEA;strokeColor=#B7791F;fontSize=10;fontFamily=Microsoft YaHei;" vertex="1" parent="1"><mxGeometry x="56" y="648" width="408" height="42" as="geometry" /></mxCell>
        <mxCell id="sideLane" value="" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=4 4;fillColor=#FBFCFC;strokeColor=#7F8C8D;strokeWidth=1.2;fontSize=12;fontFamily=Microsoft YaHei;" vertex="1" parent="1"><mxGeometry x="540" y="28" width="184" height="712" as="geometry" /></mxCell>
        <mxCell id="sideTitle" value="旁注与研究拓展（不入完整批次）" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;fontStyle=1;fontColor=#5D6D7E;fontFamily=Microsoft YaHei;" vertex="1" parent="1"><mxGeometry x="548" y="32" width="168" height="20" as="geometry" /></mxCell>
        <mxCell id="ext" value="未纳入完整批次的扩展（研究拓展，本入口不执行）：&#10;容量切分/共享输入流水驻留 DP（6.4）&#10;部分预加载与部分分桶（6.4.4）&#10;单尾切分与首波阶梯、四系数响应压缩（6.5）" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#F4F6F7;strokeColor=#7F8C8D;fontSize=10;fontFamily=Microsoft YaHei;" vertex="1" parent="1"><mxGeometry x="550" y="60" width="164" height="140" as="geometry" /></mxCell>
        <mxCell id="branchLane" value="" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 4;fillColor=#FDF8F2;strokeColor=#D35400;strokeWidth=1.5;fontSize=12;fontFamily=Microsoft YaHei;" vertex="1" parent="1"><mxGeometry x="540" y="480" width="184" height="260" as="geometry" /></mxCell>
        <mxCell id="branchTitle" value="同计划无 L2 对照分支（仅报告指标）" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=11.5;fontStyle=1;fontColor=#D35400;fontFamily=Microsoft YaHei;" vertex="1" parent="1"><mxGeometry x="548" y="484" width="168" height="32" as="geometry" /></mxCell>
        <mxCell id="nol2" value="同计划无 L2 评价：同一方案字节在无 L2 场景评 M₂(G,P)（式 6-4；仅 Cache 场景变化；配对审计绑定计划身份：476 份复用 / 24 份另评）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D35400;fontSize=10;fontFamily=Microsoft YaHei;" vertex="1" parent="1"><mxGeometry x="548" y="522" width="168" height="98" as="geometry" /></mxCell>
        <mxCell id="cg" value="CacheGain 出口：C = M₃ / M₂&#10;报告指标；候选接受仍只比较 M₃，不与独立优化的 P2 主算法比较混同" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#B7791F;fontSize=10;fontFamily=Microsoft YaHei;" vertex="1" parent="1"><mxGeometry x="548" y="634" width="168" height="94" as="geometry" /></mxCell>
