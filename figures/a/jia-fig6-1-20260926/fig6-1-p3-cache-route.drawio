        <mxCell id="e6" value="未被剪枝的候选" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#34495E;strokeWidth=1.3;exitX=0.5;exitY=1;entryX=0.5;entryY=0;fontSize=10;fontFamily=Microsoft YaHei;verticalAlign=top;" edge="1" parent="1" source="prune" target="e0"><mxGeometry relative="1" as="geometry" /></mxCell>
