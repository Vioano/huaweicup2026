<mxfile host="app.diagrams.net" agent="jia-fig4-1" version="24.7.8">
  <diagram id="fig4-1" name="图4-1 P1两层决策与官方评价流程">
    <mxGraphModel dx="1422" dy="798" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1240" pageHeight="1240" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="图 4-1｜P1 两层决策与官方评价流程（完整算法 v4@a0537aeb → 官方冻结评估器）" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=17;fontStyle=1;fontFamily=Microsoft YaHei;" vertex="1" parent="1"><mxGeometry x="80" y="16" width="1080" height="34" as="geometry" /></mxCell>
        <mxCell id="layerTop" value="上层｜求解器决策 —— 统一 v4 入口 src/q1/unified.py（六候选 · 字节去重 · 单候选直达 / 多候选在线选优）" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 4;fillColor=#F4F9FD;strokeColor=#2E86AB;strokeWidth=1.6;fontSize=13;fontStyle=1;fontFamily=Microsoft YaHei;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="40" y="64" width="1160" height="560" as="geometry" /></mxCell>
        <mxCell id="in" value="输入&#10;原始计算图 G · 核数 K · 冻结配置 Θ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D6E8F5;strokeColor=#2E86AB;fontSize=12;fontFamily=Microsoft YaHei;" vertex="1" parent="1"><mxGeometry x="66" y="118" width="190" height="66" as="geometry" /></mxCell>
        <mxCell id="identify" value="结构特征识别&#10;弱连通分量 · Pipe 工作量 (4-10)&#10;分叉阶段 (4-11) · 共享输入 · 同型链" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D6E8F5;strokeColor=#2E86AB;fontSize=12;fontFamily=Microsoft YaHei;" vertex="1" parent="1"><mxGeometry x="300" y="112" width="268" height="78" as="geometry" /></mxCell>
        <mxCell id="candBox" value="六类结构候选构造（统一入口 generate_candidates，至多 6 个不同方案）&#10;可选候选构造失败跳过；必需 bounded 候选失败则终止求解" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF3FB;strokeColor=#2E86AB;fontSize=12;fontStyle=1;fontFamily=Microsoft YaHei;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="612" y="96" width="560" height="176" as="geometry" /></mxCell>
        <mxCell id="c1" value="① 完整分量 + 有界树前沿（bounded，必需）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5DA7CC;fontSize=11;fontFamily=Microsoft YaHei;" vertex="1" parent="candBox"><mxGeometry x="14" y="50" width="262" height="38" as="geometry" /></mxCell>
        <mxCell id="c2" value="② 重分量 + 独占后缀（heavy-or-sink）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5DA7CC;fontSize=11;fontFamily=Microsoft YaHei;" vertex="1" parent="candBox"><mxGeometry x="288" y="50" width="258" height="38" as="geometry" /></mxCell>
        <mxCell id="c3" value="③ 超载分量分解（overload）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5DA7CC;fontSize=11;fontFamily=Microsoft YaHei;" vertex="1" parent="candBox"><mxGeometry x="14" y="96" width="262" height="38" as="geometry" /></mxCell>
        <mxCell id="c4" value="④ 输入预算 + 活跃核选择（shared-input）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5DA7CC;fontSize=11;fontFamily=Microsoft YaHei;" vertex="1" parent="candBox"><mxGeometry x="288" y="96" width="258" height="38" as="geometry" /></mxCell>
        <mxCell id="c5" value="⑤ 容量约束回转分组（capacity-return）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5DA7CC;fontSize=11;fontFamily=Microsoft YaHei;" vertex="1" parent="candBox"><mxGeometry x="14" y="142" width="262" height="28" as="geometry" /></mxCell>
        <mxCell id="c6" value="⑥ 分叉阶段前沿（fork-frontier，grain=4）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5DA7CC;fontSize=11;fontFamily=Microsoft YaHei;" vertex="1" parent="candBox"><mxGeometry x="288" y="142" width="258" height="28" as="geometry" /></mxCell>
        <mxCell id="dedup" value="构造入口 add()：每个候选构造出 plan 后，立即对实际输出字节 plan_bytes（JSON 序列化）计算 SHA-256 去重，重复只保留首个；plan_bytes 仅做字节去重，不做合法性检查" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D6E8F5;strokeColor=#2E86AB;fontSize=12;fontFamily=Microsoft YaHei;" vertex="1" parent="1"><mxGeometry x="612" y="290" width="560" height="62" as="geometry" /></mxCell>
        <mxCell id="decision" value="solve：去重后候选数 = 1？（unified.py solve / choose 分支）" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF7E6;strokeColor=#B7791F;fontSize=12;fontStyle=1;fontFamily=Microsoft YaHei;" vertex="1" parent="1"><mxGeometry x="680" y="368" width="440" height="56" as="geometry" /></mxCell>
        <mxCell id="single" value="直接选定唯一候选（choose：single-distinct-plan）&#10;不启动在线 E1 评分&#10;输出方案仍需独立 E0 复评" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#B7791F;fontSize=12;fontFamily=Microsoft YaHei;" vertex="1" parent="1"><mxGeometry x="300" y="448" width="268" height="84" as="geometry" /></mxCell>
        <mxCell id="e1" value="在线选优 · 固定 E1（队内加速评价，非正式成绩）—— 仅多候选路径&#10;src.eval_exact.P1BatchEvaluator：1 worker · 16 MiB 缓存 · 60 s/项 · 启动限额 10 s&#10;按 (Makespan, scheduled COPY bytes) 更新最优；首个评分失败即停，保留已知最好&#10;在线 E1 评分计入求解计时，与实验阶段独立 E0 复评分开表示" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#1F5FA8;fontSize=12;fontFamily=Microsoft YaHei;" vertex="1" parent="1"><mxGeometry x="680" y="440" width="492" height="110" as="geometry" /></mxCell>
        <mxCell id="plan" value="官方方案文件 P（main --output，磁盘传递）—— 严格只含两个字段：node_to_subgraph（切图）｜core_schedules（每核 Task 顺序）；不含任何诊断内容" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#B7791F;strokeWidth=2;fontSize=12.5;fontStyle=1;fontFamily=Microsoft YaHei;" vertex="1" parent="1"><mxGeometry x="180" y="640" width="880" height="56" as="geometry" /></mxCell>
        <mxCell id="diag" value="诊断记录（main --diagnostics，独立 JSON 文件）&#10;算法 ID · 候选清单与 SHA · 在线评分记录 · 耗时等过程信息&#10;不属官方方案 JSON，不进官方评估器" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#FCF4E4;strokeColor=#B7791F;fontSize=11;fontFamily=Microsoft YaHei;" vertex="1" parent="1"><mxGeometry x="480" y="716" width="360" height="66" as="geometry" /></mxCell>
        <mxCell id="note1" value="提交者仅决定三项：切图、分核、每核 Task 顺序；&#10;逐 Pipe 执行顺序、等待时间与模拟时间线均由冻结评估器确定。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=11;fontColor=#566573;fontFamily=Microsoft YaHei;" vertex="1" parent="1"><mxGeometry x="56" y="208" width="216" height="84" as="geometry" /></mxCell>
        <mxCell id="layerBottom" value="下层｜官方评价 —— 冻结评估器 multicore_cut_evaluate_problem_1.py（提交者不可修改）" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 4;fillColor=#FDF8F2;strokeColor=#D35400;strokeWidth=1.6;fontSize=13;fontStyle=1;fontFamily=Microsoft YaHei;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="40" y="800" width="1160" height="320" as="geometry" /></mxCell>
        <mxCell id="read" value="读入方案文件&#10;按两键重建子图 / Task" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDEBD0;strokeColor=#D35400;fontSize=12;fontFamily=Microsoft YaHei;" vertex="1" parent="1"><mxGeometry x="66" y="860" width="196" height="66" as="geometry" /></mxCell>
        <mxCell id="copy" value="边界 COPY 重建&#10;Task 边界数据搬运&#10;（COPY_OUT → DDR → COPY_IN）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDEBD0;strokeColor=#D35400;fontSize=12;fontFamily=Microsoft YaHei;" vertex="1" parent="1"><mxGeometry x="316" y="852" width="238" height="82" as="geometry" /></mxCell>
        <mxCell id="steps" value="官方核内调度（固定三步）&#10;Step1 核内拓扑顺序（schedule_step1.py）&#10;Step2 缓存换入 / 换出（schedule_step2.py）&#10;Step3 四 Pipe 时间线（schedule_step3.py）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDEBD0;strokeColor=#D35400;fontSize=11.5;fontFamily=Microsoft YaHei;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="608" y="840" width="296" height="106" as="geometry" /></mxCell>
        <mxCell id="sim" value="多核事件模拟&#10;DDR 共享 60 B/cycle&#10;同核 / 跨核 Task 门控 100 / 1000 cyc" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDEBD0;strokeColor=#D35400;fontSize=12;fontFamily=Microsoft YaHei;" vertex="1" parent="1"><mxGeometry x="958" y="852" width="216" height="82" as="geometry" /></mxCell>
        <mxCell id="e0" value="E0 独立最终复评&#10;实验阶段 · 未修改官方评估器&#10;（与上层在线 E1 分开表示）" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#FDF2E9;strokeColor=#A04000;fontSize=11.5;fontFamily=Microsoft YaHei;" vertex="1" parent="1"><mxGeometry x="66" y="994" width="250" height="76" as="geometry" /></mxCell>
        <mxCell id="out1" value="评价出口 ①&#10;Makespan（cycles）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDEBD0;strokeColor=#D35400;strokeWidth=2;fontSize=12.5;fontStyle=1;fontFamily=Microsoft YaHei;" vertex="1" parent="1"><mxGeometry x="420" y="998" width="280" height="66" as="geometry" /></mxCell>
        <mxCell id="out2" value="评价出口 ②&#10;额外数据搬运量（B）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDEBD0;strokeColor=#D35400;strokeWidth=2;fontSize=12.5;fontStyle=1;fontFamily=Microsoft YaHei;" vertex="1" parent="1"><mxGeometry x="760" y="998" width="280" height="66" as="geometry" /></mxCell>
        <mxCell id="note2" value="口径：Makespan 单位 cycles；额外 DDR 为调度后全部 DDR 搬运量扣除原始计算图已有搬运量；Cache 命中率等次级指标见正文 4.3。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=11;fontColor=#566573;fontFamily=Microsoft YaHei;" vertex="1" parent="1"><mxGeometry x="66" y="1130" width="1130" height="28" as="geometry" /></mxCell>
        <mxCell id="note3" value="流程节点 ↔ 源码模块对应：结构识别与六候选 = unified.py generate_candidates（覆盖/依赖合法性检查在各构造器内部严格识别器，如 capacity-return 的 strict-private-chain-check）；构造失败语义 = unified.py add：可选候选失败跳过，必需 bounded 候选失败（required=True）直接 raise 终止；字节去重 = add() 内 plan_bytes 的 SHA-256；单/多候选分支 = solve + choose（len==1 → single-distinct-plan，不启动在线 E1）；在线选优 = src.eval_exact.P1BatchEvaluator（E1）；官方方案两键 = main --output；诊断旁路 = main --diagnostics；下层全链 = 官方 data/raw/a/official/code/ multicore_cut_evaluate_problem_1.py + schedule_step1/2/3.py。研究扩展（变宽分组、错峰融合等）不在本主线。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=11;fontColor=#2C3E50;fontFamily=Microsoft YaHei;" vertex="1" parent="1"><mxGeometry x="66" y="1162" width="1130" height="56" as="geometry" /></mxCell>
        <mxCell id="f1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#34495E;strokeWidth=1.4;" edge="1" parent="1" source="in" target="identify"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#34495E;strokeWidth=1.4;" edge="1" parent="1" source="identify" target="candBox"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#34495E;strokeWidth=1.4;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="candBox" target="dedup"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#34495E;strokeWidth=1.4;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="dedup" target="decision"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f5" value="多个候选" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#34495E;strokeWidth=1.4;fontSize=11;exitX=0.25;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="decision" target="e1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f6" value="仅 1 个候选" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#B7791F;strokeWidth=1.6;fontSize=11;exitX=0;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="decision" target="single"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f7" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#B7791F;strokeWidth=1.6;exitX=0.5;exitY=1;entryX=0.25;entryY=0;" edge="1" parent="1" source="single" target="plan"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f8" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#B7791F;strokeWidth=1.8;exitX=0.75;exitY=1;entryX=0.75;entryY=0;" edge="1" parent="1" source="e1" target="plan"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f9" value="--diagnostics" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#B7791F;strokeWidth=1.4;dashed=1;fontSize=11;exitX=0.55;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="plan" target="diag"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f10" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#B7791F;strokeWidth=1.8;dashed=1;exitX=0.1;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="plan" target="read"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="268" y="836" /><mxPoint x="164" y="836" /></Array></mxGeometry></mxCell>
        <mxCell id="f11" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#A04000;strokeWidth=1.4;" edge="1" parent="1" source="read" target="copy"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f12" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#A04000;strokeWidth=1.4;" edge="1" parent="1" source="copy" target="steps"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f13" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#A04000;strokeWidth=1.4;" edge="1" parent="1" source="steps" target="sim"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f14" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#A04000;strokeWidth=1.4;exitX=0.25;exitY=1;" edge="1" parent="1" source="sim" target="out1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f15" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#A04000;strokeWidth=1.4;exitX=0.75;exitY=1;" edge="1" parent="1" source="sim" target="out2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f16" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#A04000;strokeWidth=1.2;dashed=1;exitX=0.5;exitY=0;entryX=0;entryY=0.5;" edge="1" parent="1" source="e0" target="read"><mxGeometry relative="1" as="geometry" /></mxCell>
