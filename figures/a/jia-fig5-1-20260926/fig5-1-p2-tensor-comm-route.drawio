        <mxCell id="route" value="结构路由初解 Π₀（adaptive_budget / adaptive_semantic）&#10;M→V*→M 计算交织 · 张量归约树串行块 · 完整弱分量 / DAG 最早完成 · 共享输入波次" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5DA7CC;fontSize=10.5;fontFamily=Microsoft YaHei;" vertex="1" parent="1"><mxGeometry x="56" y="114" width="408" height="64" as="geometry" /></mxCell>
        <mxCell id="cores" value="活跃核数选择（式 5-7）&#10;L̂(q)=max(⌈J/q⌉W, ⌈(qS+P)/B⌉, H)，取最少核的模型最优" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5DA7CC;fontSize=10.5;fontFamily=Microsoft YaHei;" vertex="1" parent="1"><mxGeometry x="56" y="190" width="408" height="54" as="geometry" /></mxCell>
        <mxCell id="guard" value="分叉汇合守卫&#10;与物理依赖检查通过？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#B7791F;fontSize=10.5;fontFamily=Microsoft YaHei;" vertex="1" parent="1"><mxGeometry x="186" y="256" width="148" height="62" as="geometry" /></mxCell>
        <mxCell id="gap" value="链收缩 + 间隙日历排程 → Πgap（gap_candidate / gap_calendar）&#10;式(5-8) 逆拓扑 r_j · 空隙放置 · 汇合时至多 k² 核心对比较" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5DA7CC;fontSize=10.5;fontFamily=Microsoft YaHei;" vertex="1" parent="1"><mxGeometry x="56" y="332" width="408" height="62" as="geometry" /></mxCell>
        <mxCell id="hyper" value="一遍两核区域超图改进（式 5-9；hypergraph_cost / binary_hypercut）&#10;区域 ≤16 链 · Dinic 最小割 + 逐次锚定 · 流水线负载上限锚回&#10;静态基础 COPY 字节目标（非完整执行时间）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5DA7CC;fontSize=10.5;fontFamily=Microsoft YaHei;" vertex="1" parent="1"><mxGeometry x="56" y="408" width="408" height="76" as="geometry" /></mxCell>
        <mxCell id="dec" value="基础 COPY 字节&#10;严格下降？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#B7791F;fontSize=10.5;fontFamily=Microsoft YaHei;" vertex="1" parent="1"><mxGeometry x="186" y="498" width="148" height="60" as="geometry" /></mxCell>
        <mxCell id="retime" value="固定分核重排 → Πhypergap（gap_retime）&#10;只改核内优先级，不改分核" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5DA7CC;fontSize=10.5;fontFamily=Microsoft YaHei;" vertex="1" parent="1"><mxGeometry x="56" y="572" width="408" height="50" as="geometry" /></mxCell>
        <mxCell id="dedup" value="完整计划去重（式 5-10）：C = {Π₀, Πgap, Πhypergap}distinct，|C| ≤ 3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF3FB;strokeColor=#2E86AB;fontSize=11;fontFamily=Microsoft YaHei;" vertex="1" parent="1"><mxGeometry x="56" y="636" width="408" height="44" as="geometry" /></mxCell>
