        <mxCell id="mainLaneTitle" value="主线｜候选构造与完整评分（算法 5-1，c66559a6 adaptive_hypergap_guarded.py）" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;fontStyle=1;fontColor=#1F5FA8;fontFamily=Microsoft YaHei;" vertex="1" parent="1"><mxGeometry x="28" y="34" width="484" height="20" as="geometry" /></mxCell>
